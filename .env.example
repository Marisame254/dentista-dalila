# Copia este archivo como `.env` y llena los valores desde Supabase:
# Project Settings > API (o "API Keys" en el panel nuevo).
# En Vercel, agrega las mismas tres variables en Settings > Environment Variables.

# Project URL, ej. https://abcdefgh.supabase.co
SUPABASE_URL=

# Llave pública: "anon public" (o "publishable key" en el panel nuevo)
SUPABASE_ANON_KEY=

# Llave secreta: "service_role" (o "secret key"). NUNCA la compartas ni la subas a git.
SUPABASE_SERVICE_ROLE_KEY=
