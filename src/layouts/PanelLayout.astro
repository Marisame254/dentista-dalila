---
import Layout from "./Layout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { site } from "../config/site";
import { FLASH } from "../lib/panel";

interface Props {
  title: string;
}

const { title } = Astro.props;
const supabase = Astro.locals.supabase;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

// Contadores del menú
let pendingCount = 0;
let unreadCount = 0;
if (supabase) {
  const [pending, unread] = await Promise.all([
    supabase
      .from("appointments")
      .select("id", { count: "exact", head: true })
      .eq("status", "pending"),
    supabase
      .from("messages")
      .select("id", { count: "exact", head: true })
      .is("read_at", null)
      .eq("archived", false),
  ]);
  pendingCount = pending.count ?? 0;
  unreadCount = unread.count ?? 0;
}

const links = [
  { href: "/panel", label: "Agenda", count: pendingCount },
  { href: "/panel/citas", label: "Citas", count: 0 },
  { href: "/panel/mensajes", label: "Mensajes", count: unreadCount },
];

const flash = FLASH[Astro.url.searchParams.get("aviso") ?? ""];
---

<Layout title={`${title} | Panel ${site.name}`} noindex>
  <header
    class="border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-950"
  >
    <div class="wrap flex items-center justify-between py-3">
      <a
        href="/panel"
        class="font-display text-xl font-medium text-gray-900 dark:text-white"
      >
        Panel de {site.name}
      </a>
      <div class="flex items-center gap-2">
        <ThemeToggle />
        <form method="POST" action="/panel/logout">
          <button type="submit" class="btn btn-secondary btn-sm">
            Cerrar sesión
          </button>
        </form>
      </div>
    </div>

    <nav class="wrap flex gap-1 overflow-x-auto" aria-label="Panel">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={path === link.href ? "page" : undefined}
            class="flex items-center gap-2 border-b-2 border-transparent px-3 py-3 text-[15px] font-medium text-gray-600 hover:text-gray-900 aria-[current=page]:border-teal-700 aria-[current=page]:text-teal-800 dark:text-gray-400 dark:hover:text-white dark:aria-[current=page]:border-teal-400 dark:aria-[current=page]:text-teal-300"
          >
            {link.label}
            {link.count > 0 && (
              <span class="rounded-full bg-teal-700 px-2 py-0.5 text-xs font-semibold text-white dark:bg-teal-400 dark:text-gray-950">
                {link.count}
              </span>
            )}
          </a>
        ))
      }
    </nav>
  </header>

  <main class="min-h-screen bg-gray-50 py-8 dark:bg-gray-900/40">
    <div class="wrap">
      {
        flash && (
          <p
            role="status"
            class:list={[
              "mb-6 rounded-lg px-4 py-3 text-sm font-medium",
              flash.ok
                ? "bg-teal-50 text-teal-900 dark:bg-teal-950 dark:text-teal-100"
                : "bg-red-50 text-red-800 dark:bg-red-950 dark:text-red-200",
            ]}
          >
            {flash.text}
          </p>
        )
      }
      <slot />
    </div>
  </main>
</Layout>
