---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Consultorio from "../components/Consultorio.astro";
import Appointments from "../components/Appointments.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { site } from "../config/site";

// Toda la configuración del negocio vive en src/config/site.ts
const { locality } = site.address;
---

<Layout
  title={`Dentista en ${locality} | ${site.name} — Consultorio Dental`}
  description={`Consultorio dental de la ${site.name} en ${locality}. Odontología general, estética dental, ortodoncia, implantes y odontopediatría con atención personalizada. Agenda tu cita.`}
>
  <Header />

  <main>
    <Hero />
    <Services />
    <Consultorio />
    <Appointments
      calendlyUrl={site.calendlyUrl}
      whatsappNumber={site.whatsapp}
    />
  </main>

  <Footer />

  <!-- WhatsApp Floating Button -->
  <WhatsAppButton phoneNumber={site.whatsapp} />
</Layout>
