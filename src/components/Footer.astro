---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import { site } from "../config/site";

const fullAddress = [
  site.address.street,
  site.address.locality,
  site.address.region,
  site.address.postalCode,
]
  .filter(Boolean)
  .join(", ");

const links = [
  { href: "/#servicios", label: "Servicios" },
  { href: "/#consultorio", label: "Consultorio" },
  { href: "/#sobre-mi", label: "Sobre mí" },
  { href: "/#citas", label: "Agendar cita" },
  { href: "/privacidad", label: "Aviso de privacidad" },
];

const socials = [
  {
    label: "Facebook",
    href: site.social.facebook,
    path: "M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z",
  },
  {
    label: "Instagram",
    href: site.social.instagram,
    path: "M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z",
  },
].filter((social) => social.href);
---

<footer class="bg-gray-900 py-14 text-gray-300 dark:bg-black">
  <div class="wrap">
    <div class="grid gap-10 md:grid-cols-3">
      <!-- Brand -->
      <div>
        <a href="/#inicio" class="flex items-center gap-2.5">
          <Image
            src={logo}
            alt=""
            width={40}
            height={40}
            class="h-10 w-10 rounded-full"
          />
          <span class="font-display text-2xl font-medium text-white"
            >{site.name}</span
          >
        </a>
        <p class="mt-4 max-w-xs leading-relaxed text-gray-400">
          Consultorio dental en {site.address.locality}. Atención personal para
          toda la familia.
        </p>

        <!-- Social links -->
        {
          socials.length > 0 && (
            <div class="mt-6 flex gap-3">
              {socials.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-800 transition-colors hover:bg-teal-700"
                  aria-label={social.label}
                >
                  <svg
                    class="h-5 w-5"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d={social.path} />
                  </svg>
                </a>
              ))}
            </div>
          )
        }
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-semibold text-white">Enlaces</h3>
        <ul class="mt-4 space-y-2.5">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-gray-400 transition-colors hover:text-white"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="font-semibold text-white">Contacto</h3>
        <dl class="mt-4 space-y-3 text-gray-400">
          <div>
            <dt class="text-sm text-gray-500">Teléfono / WhatsApp</dt>
            <dd>
              <a
                href={`https://wa.me/${site.whatsapp}`}
                target="_blank"
                rel="noopener noreferrer"
                class="transition-colors hover:text-white"
              >
                {site.phone}
              </a>
            </dd>
          </div>
          <div>
            <dt class="text-sm text-gray-500">Dirección</dt>
            <dd>{fullAddress}</dd>
          </div>
          <div>
            <dt class="text-sm text-gray-500">Horario</dt>
            <dd>{site.openingHoursLabel}</dd>
          </div>
        </dl>
      </div>
    </div>

    <p class="mt-12 border-t border-gray-800 pt-8 text-sm text-gray-500">
      &copy; {new Date().getFullYear()}
      {site.name}, consultorio dental. Todos los derechos reservados.
    </p>
  </div>
</footer>
