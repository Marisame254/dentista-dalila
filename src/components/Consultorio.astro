---
import { Image } from "astro:assets";
import areaDeTrabajo from "../assets/area-de-trabajo.jpg";
import consultorio from "../assets/consultorio.png";
import radiografia from "../assets/radiografia.jpg";

const images = [
  {
    src: areaDeTrabajo,
    alt: "La doctora y una paciente en la sala de tratamiento del consultorio",
    title: "Sala de tratamiento",
  },
  {
    src: radiografia,
    alt: "La doctora explica una radiografía dental a una paciente en la computadora",
    title: "Radiografía digital",
  },
  {
    src: consultorio,
    alt: "La doctora atendiendo a una paciente en el sillón dental",
    title: "Atención personal",
  },
];

const features = [
  {
    title: "Esterilización certificada",
    description: "Protocolos de bioseguridad de primer nivel.",
  },
  {
    title: "Equipos modernos",
    description: "Tecnología digital de última generación.",
  },
  {
    title: "Ambiente acogedor",
    description: "Espacios diseñados para tu comodidad.",
  },
];
---

<section id="consultorio" class="bg-gray-50 py-16 md:py-24 dark:bg-gray-900">
  <div class="wrap">
    <h2 class="section-title">El consultorio</h2>
    <p class="section-lead">
      Un espacio moderno y acogedor, pensado para que te sientas tranquilo
      durante tu consulta.
    </p>

    <!-- Gallery -->
    <div class="mt-10 grid gap-5 sm:grid-cols-3">
      {
        images.map((image) => (
          <figure>
            <Image
              src={image.src}
              alt={image.alt}
              widths={[320, 480, 720]}
              sizes="(min-width: 640px) 30vw, 90vw"
              class="aspect-[3/4] w-full rounded-xl object-cover"
            />
            <figcaption class="mt-3 text-sm font-medium text-gray-700 dark:text-gray-300">
              {image.title}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <!-- Features -->
    <dl
      class="mt-12 grid gap-8 border-t border-gray-200 pt-8 sm:grid-cols-3 dark:border-gray-800"
    >
      {
        features.map((feature) => (
          <div>
            <dt class="font-semibold text-gray-900 dark:text-white">
              {feature.title}
            </dt>
            <dd class="mt-1 text-gray-600 dark:text-gray-400">
              {feature.description}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
