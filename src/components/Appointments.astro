---
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { site } from "../config/site";

const whatsappUrl = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent("Hola! Me gustaría agendar una cita.")}`;
---

<section id="citas" class="py-16 md:py-24">
  <div class="wrap">
    <h2 class="section-title">Agenda tu cita</h2>
    <p class="section-lead">
      Elige el día y la hora que prefieras. La doctora revisa tu solicitud y te
      confirma por WhatsApp.
    </p>

    <div class="mt-10 grid items-start gap-8 lg:grid-cols-[1.4fr_1fr]">
      <!-- Booking form -->
      <div class="card min-w-0 p-6 sm:p-8">
        <form id="booking-form" class="space-y-7" novalidate>
          <div>
            <label for="booking-service" class="label">Servicio</label>
            <select id="booking-service" name="service" class="field" required>
              {site.services.map((service) => <option>{service}</option>)}
            </select>
          </div>

          <fieldset class="min-w-0">
            <legend class="label">Día</legend>
            <div
              id="booking-days"
              class="-mx-1 flex gap-2 overflow-x-auto px-1 py-1 sm:flex-wrap"
            >
            </div>
          </fieldset>

          <fieldset>
            <legend class="label">Hora</legend>
            <div id="booking-slots" class="flex flex-wrap gap-2"></div>
            <p
              id="booking-slots-status"
              class="text-sm text-gray-600 dark:text-gray-400"
              aria-live="polite"
            >
              Elige un día para ver los horarios disponibles.
            </p>
          </fieldset>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="booking-name" class="label">Nombre completo</label>
              <input
                id="booking-name"
                name="name"
                type="text"
                class="field"
                autocomplete="name"
                maxlength="80"
                required
              />
            </div>
            <div>
              <label for="booking-phone" class="label"
                >Teléfono con WhatsApp</label
              >
              <input
                id="booking-phone"
                name="phone"
                type="tel"
                class="field"
                autocomplete="tel"
                inputmode="tel"
                placeholder="951 123 4567"
                maxlength="20"
                required
              />
            </div>
          </div>

          <div>
            <label for="booking-note" class="label"
              >Motivo de la consulta (opcional)</label
            >
            <textarea
              id="booking-note"
              name="note"
              class="field"
              rows="3"
              maxlength="500"></textarea>
          </div>

          <!-- Campo trampa para bots: oculto para las personas -->
          <div class="hidden" aria-hidden="true">
            <label>
              Sitio web
              <input name="website" type="text" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <label
            class="flex items-start gap-3 text-sm text-gray-700 dark:text-gray-300"
          >
            <input
              name="consent"
              type="checkbox"
              class="mt-0.5 h-4 w-4 accent-teal-700"
              required
            />
            <span>
              Acepto el
              <a
                href="/privacidad"
                class="font-semibold text-teal-700 underline underline-offset-2 dark:text-teal-300"
                >aviso de privacidad</a
              >
              y que me contacten por WhatsApp sobre mi cita.
            </span>
          </label>

          <p
            id="booking-error"
            class="hidden rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800 dark:bg-red-950 dark:text-red-200"
            role="alert"
          >
          </p>

          <button type="submit" class="btn btn-primary w-full sm:w-auto">
            Solicitar cita
          </button>

          <noscript>
            <p class="text-sm text-gray-700 dark:text-gray-300">
              Para agendar en línea necesitas activar JavaScript. También puedes
              escribirnos por WhatsApp.
            </p>
          </noscript>
        </form>

        <!-- Shown after a successful request -->
        <div id="booking-success" class="hidden" tabindex="-1">
          <h3
            class="font-display text-2xl font-medium text-gray-900 dark:text-white"
          >
            Solicitud enviada
          </h3>
          <p class="mt-3 leading-relaxed text-gray-700 dark:text-gray-300">
            Recibimos tu solicitud para el
            <strong id="booking-success-when"></strong>. La doctora te
            confirmará por WhatsApp; hasta entonces la cita queda pendiente.
          </p>
          <button
            id="booking-again"
            type="button"
            class="btn btn-secondary mt-6"
          >
            Solicitar otra cita
          </button>
        </div>
      </div>

      <!-- Other ways to reach the practice -->
      <div class="min-w-0 space-y-6">
        <div class="card p-6">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
            ¿Prefieres WhatsApp?
          </h3>
          <p class="mt-2 text-gray-600 dark:text-gray-400">
            Escríbenos y te ayudamos a encontrar un horario.
          </p>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp mt-4"
          >
            <WhatsAppIcon />
            Escribir por WhatsApp
          </a>
        </div>

        <div class="card p-6">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
            ¿Tienes una duda?
          </h3>
          <p class="mt-2 text-gray-600 dark:text-gray-400">
            Déjanos tu mensaje y te respondemos por WhatsApp.
          </p>

          <form id="message-form" class="mt-4 space-y-4" novalidate>
            <div>
              <label for="message-name" class="label">Nombre</label>
              <input
                id="message-name"
                name="name"
                type="text"
                class="field"
                autocomplete="name"
                maxlength="80"
                required
              />
            </div>
            <div>
              <label for="message-phone" class="label"
                >Teléfono con WhatsApp</label
              >
              <input
                id="message-phone"
                name="phone"
                type="tel"
                class="field"
                autocomplete="tel"
                inputmode="tel"
                maxlength="20"
                required
              />
            </div>
            <div>
              <label for="message-body" class="label">Mensaje</label>
              <textarea
                id="message-body"
                name="body"
                class="field"
                rows="3"
                maxlength="1000"
                required></textarea>
            </div>

            <div class="hidden" aria-hidden="true">
              <label>
                Sitio web
                <input
                  name="website"
                  type="text"
                  tabindex="-1"
                  autocomplete="off"
                />
              </label>
            </div>

            <label
              class="flex items-start gap-3 text-sm text-gray-700 dark:text-gray-300"
            >
              <input
                name="consent"
                type="checkbox"
                class="mt-0.5 h-4 w-4 accent-teal-700"
                required
              />
              <span>
                Acepto el
                <a
                  href="/privacidad"
                  class="font-semibold text-teal-700 underline underline-offset-2 dark:text-teal-300"
                  >aviso de privacidad</a
                >.
              </span>
            </label>

            <p
              id="message-status"
              class="hidden rounded-lg px-4 py-3 text-sm"
              role="alert"
            >
            </p>

            <button type="submit" class="btn btn-secondary">
              Enviar mensaje
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { actions, isInputError } from "astro:actions";
  import { formatClock } from "../lib/format";
  import { bookableDates } from "../lib/slots";

  const CHIP =
    "relative cursor-pointer whitespace-nowrap rounded-lg border border-gray-300 bg-white px-3.5 py-2 text-sm font-medium text-gray-800 hover:border-teal-700 has-checked:border-teal-700 has-checked:bg-teal-700 has-checked:text-white has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-teal-700 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-200 dark:hover:border-teal-400 dark:has-checked:border-teal-400 dark:has-checked:bg-teal-400 dark:has-checked:text-gray-950";
  const ERROR_CLASSES =
    "bg-red-50 text-red-800 dark:bg-red-950 dark:text-red-200";
  const OK_CLASSES =
    "bg-teal-50 text-teal-900 dark:bg-teal-950 dark:text-teal-100";

  const dayChip = new Intl.DateTimeFormat("es-MX", {
    timeZone: "UTC",
    weekday: "short",
    day: "numeric",
    month: "short",
  });
  const dayLong = new Intl.DateTimeFormat("es-MX", {
    timeZone: "UTC",
    weekday: "long",
    day: "numeric",
    month: "long",
  });
  const asDate = (date: string) => new Date(`${date}T12:00:00Z`);

  /** Orden en que aparecen los campos, para avisar primero del más alto */
  const FIELD_ORDER = ["service", "date", "time", "name", "phone", "note", "body"];

  /** Mensaje para la persona a partir del error de una Action */
  function errorMessage(error: unknown): string {
    if (isInputError(error)) {
      const fields = error.fields as Record<string, string[] | undefined>;
      const names = [...FIELD_ORDER, ...Object.keys(fields)];
      const first = names.map((name) => fields[name]?.[0]).find(Boolean);
      if (first) return first;
    }
    if (error instanceof Error && error.message) return error.message;
    return "No pudimos enviar tu solicitud. Intenta de nuevo o escríbenos por WhatsApp.";
  }

  function radioChip(name: string, value: string, text: string): HTMLElement {
    const label = document.createElement("label");
    label.className = CHIP;
    const input = document.createElement("input");
    input.type = "radio";
    input.name = name;
    input.value = value;
    input.className = "sr-only";
    label.append(input, text);
    return label;
  }

  // --- Solicitud de cita ---------------------------------------------------
  const form = document.querySelector<HTMLFormElement>("#booking-form");
  const days = document.querySelector<HTMLElement>("#booking-days");
  const slots = document.querySelector<HTMLElement>("#booking-slots");
  const slotsStatus = document.querySelector<HTMLElement>(
    "#booking-slots-status",
  );
  const bookingError = document.querySelector<HTMLElement>("#booking-error");
  const success = document.querySelector<HTMLElement>("#booking-success");
  const successWhen = document.querySelector<HTMLElement>(
    "#booking-success-when",
  );
  const again = document.querySelector<HTMLElement>("#booking-again");

  if (form && days && slots && slotsStatus && bookingError) {
    const submit = form.querySelector<HTMLButtonElement>("button[type=submit]");
    let requestId = 0;

    const showError = (message: string) => {
      bookingError.textContent = message;
      bookingError.classList.toggle("hidden", !message);
    };

    async function loadSlots(date: string) {
      const current = ++requestId;
      slots!.replaceChildren();
      slotsStatus!.textContent = "Buscando horarios…";

      const { data, error } = await actions.getAvailability({ date });
      if (current !== requestId) return; // la persona ya eligió otro día

      if (error) {
        slotsStatus!.textContent = errorMessage(error);
        return;
      }
      if (data.slots.length === 0) {
        slotsStatus!.textContent =
          "Ya no hay horarios libres ese día. Prueba con otro.";
        return;
      }
      slotsStatus!.textContent = "";
      slots!.append(
        ...data.slots.map((time) => radioChip("time", time, formatClock(time))),
      );
    }

    for (const date of bookableDates()) {
      days.append(
        radioChip("date", date, dayChip.format(asDate(date)).replace(" de ", " ")),
      );
    }
    if (days.childElementCount === 0) {
      slotsStatus.textContent =
        "Por ahora no hay días disponibles. Escríbenos por WhatsApp.";
    }

    days.addEventListener("change", (event) => {
      showError("");
      loadSlots((event.target as HTMLInputElement).value);
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      showError("");

      const data = new FormData(form);
      const date = String(data.get("date") ?? "");
      const time = String(data.get("time") ?? "");
      if (!date || !time) {
        showError("Elige el día y la hora de tu cita.");
        return;
      }

      submit?.setAttribute("disabled", "");
      const { error } = await actions.requestAppointment({
        service: String(data.get("service")) as never,
        date,
        time,
        name: String(data.get("name") ?? ""),
        phone: String(data.get("phone") ?? ""),
        note: String(data.get("note") ?? ""),
        consent: (data.get("consent") === "on") as true,
        website: String(data.get("website") ?? ""),
      });
      submit?.removeAttribute("disabled");

      if (error) {
        showError(errorMessage(error));
        // El horario pudo ocuparse mientras llenaban el formulario.
        if (error.code === "CONFLICT") loadSlots(date);
        return;
      }

      if (successWhen) {
        successWhen.textContent = `${dayLong.format(asDate(date))} a las ${formatClock(time)}`;
      }
      form.classList.add("hidden");
      success?.classList.remove("hidden");
      success?.focus();
    });

    again?.addEventListener("click", () => {
      form.reset();
      slots.replaceChildren();
      slotsStatus.textContent =
        "Elige un día para ver los horarios disponibles.";
      success?.classList.add("hidden");
      form.classList.remove("hidden");
    });
  }

  // --- Mensaje a la doctora ------------------------------------------------
  const messageForm = document.querySelector<HTMLFormElement>("#message-form");
  const messageStatus = document.querySelector<HTMLElement>("#message-status");

  if (messageForm && messageStatus) {
    const submit = messageForm.querySelector<HTMLButtonElement>(
      "button[type=submit]",
    );

    const showStatus = (message: string, ok: boolean) => {
      messageStatus.textContent = message;
      messageStatus.className = `rounded-lg px-4 py-3 text-sm ${ok ? OK_CLASSES : ERROR_CLASSES}`;
    };

    messageForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(messageForm);

      submit?.setAttribute("disabled", "");
      const { error } = await actions.sendMessage({
        name: String(data.get("name") ?? ""),
        phone: String(data.get("phone") ?? ""),
        body: String(data.get("body") ?? ""),
        consent: (data.get("consent") === "on") as true,
        website: String(data.get("website") ?? ""),
      });
      submit?.removeAttribute("disabled");

      if (error) {
        showStatus(errorMessage(error), false);
        return;
      }
      messageForm.reset();
      showStatus("Mensaje enviado. Te responderemos por WhatsApp.", true);
    });
  }
</script>
