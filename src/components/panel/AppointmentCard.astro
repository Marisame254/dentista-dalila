---
import WhatsAppIcon from "../WhatsAppIcon.astro";
import {
  formatDate,
  formatTime,
  whatsappLink,
  whatsappNumber,
} from "../../lib/format";
import { appointmentWhatsAppText } from "../../lib/panel";
import { utcToZoned } from "../../lib/slots";
import { STATUS_LABELS, type Appointment } from "../../lib/types";

interface Props {
  appointment: Appointment;
}

const { appointment } = Astro.props;
const { status } = appointment;

const when = `${formatDate(appointment.starts_at)} a las ${formatTime(appointment.starts_at)}`;
const zoned = utcToZoned(new Date(appointment.starts_at));
const whatsappUrl = whatsappLink(
  appointment.patient_phone,
  appointmentWhatsAppText({ ...appointment, when }),
);

const whatsappLabel =
  status === "confirmed"
    ? "Avisar confirmación"
    : status === "cancelled"
      ? "Proponer otro horario"
      : "Escribir por WhatsApp";

const badgeClasses: Record<Appointment["status"], string> = {
  pending: "bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-200",
  confirmed: "bg-teal-100 text-teal-900 dark:bg-teal-950 dark:text-teal-200",
  completed: "bg-gray-200 text-gray-800 dark:bg-gray-800 dark:text-gray-200",
  cancelled: "bg-red-100 text-red-900 dark:bg-red-950 dark:text-red-200",
  no_show: "bg-red-100 text-red-900 dark:bg-red-950 dark:text-red-200",
};

/** Botones de cambio de estado disponibles según el estado actual */
const transitions: { status: string; label: string; class: string }[] =
  status === "pending"
    ? [
        { status: "confirmed", label: "Confirmar", class: "btn-primary" },
        { status: "cancelled", label: "Rechazar", class: "btn-danger" },
      ]
    : status === "confirmed"
      ? [
          { status: "completed", label: "Completada", class: "btn-secondary" },
          { status: "no_show", label: "No asistió", class: "btn-secondary" },
          { status: "cancelled", label: "Cancelar", class: "btn-danger" },
        ]
      : [{ status: "confirmed", label: "Reactivar", class: "btn-secondary" }];

const canReschedule = status === "pending" || status === "confirmed";
---

<article class="card p-5">
  <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
    <div>
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
        {appointment.patient_name}
      </h3>
      <p class="mt-0.5 text-gray-700 dark:text-gray-300">
        <span class="inline-block first-letter:uppercase">{formatDate(appointment.starts_at)}</span>,
        {formatTime(appointment.starts_at)}
      </p>
      <p class="text-sm text-gray-600 dark:text-gray-400">
        {appointment.service}, {appointment.duration_min} min
      </p>
    </div>
    <span
      class:list={[
        "rounded-full px-2.5 py-1 text-xs font-semibold",
        badgeClasses[status],
      ]}
    >
      {STATUS_LABELS[status]}
    </span>
  </div>

  {
    appointment.patient_note && (
      <p class="mt-3 border-l-2 border-gray-300 pl-3 text-gray-700 dark:border-gray-700 dark:text-gray-300">
        {appointment.patient_note}
      </p>
    )
  }

  <div class="mt-4 flex flex-wrap gap-2">
    {
      transitions.map((transition) => (
        <form method="POST">
          <input type="hidden" name="intent" value="appointment-status" />
          <input type="hidden" name="id" value={appointment.id} />
          <input type="hidden" name="status" value={transition.status} />
          <button type="submit" class:list={["btn btn-sm", transition.class]}>
            {transition.label}
          </button>
        </form>
      ))
    }
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-sm btn-whatsapp"
    >
      <WhatsAppIcon class="h-4 w-4" />
      {whatsappLabel}
    </a>
    <a href={`tel:+${whatsappNumber(appointment.patient_phone)}`} class="btn btn-sm btn-secondary">
      Llamar
    </a>
  </div>

  <div
    class="mt-4 space-y-2 border-t border-gray-200 pt-3 text-sm dark:border-gray-800"
  >
    {
      canReschedule && (
        <details>
          <summary class="cursor-pointer font-medium text-teal-800 dark:text-teal-300">
            Reprogramar
          </summary>
          <form method="POST" class="mt-3 flex flex-wrap items-end gap-3">
            <input type="hidden" name="intent" value="appointment-reschedule" />
            <input type="hidden" name="id" value={appointment.id} />
            <label>
              <span class="label">Día</span>
              <input
                type="date"
                name="date"
                class="field"
                value={zoned.date}
                required
              />
            </label>
            <label>
              <span class="label">Hora</span>
              <input
                type="time"
                name="time"
                class="field"
                value={zoned.time}
                step="300"
                required
              />
            </label>
            <button type="submit" class="btn btn-sm btn-primary">
              Guardar y confirmar
            </button>
          </form>
        </details>
      )
    }

    <details open={Boolean(appointment.admin_note)}>
      <summary class="cursor-pointer font-medium text-teal-800 dark:text-teal-300">
        Nota interna
      </summary>
      <form method="POST" class="mt-3 space-y-3">
        <input type="hidden" name="intent" value="appointment-note" />
        <input type="hidden" name="id" value={appointment.id} />
        <textarea
          name="admin_note"
          class="field"
          rows="2"
          maxlength="2000"
          aria-label="Nota interna"
          placeholder="Solo tú ves esta nota"
          set:text={appointment.admin_note ?? ""}
        />
        <button type="submit" class="btn btn-sm btn-secondary">
          Guardar nota
        </button>
      </form>
    </details>
  </div>
</article>
