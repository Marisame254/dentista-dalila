---
import WhatsAppIcon from "./WhatsAppIcon.astro";

interface Props {
  phoneNumber: string;
  message?: string;
}

const {
  phoneNumber,
  message = "Hola! Me gustaría obtener más información sobre los servicios dentales.",
} = Astro.props;

const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-green-600 text-white shadow-lg transition-colors hover:bg-green-700"
  aria-label="Contactar por WhatsApp"
  title="Escríbenos por WhatsApp"
>
  <WhatsAppIcon class="h-7 w-7" />
</a>
