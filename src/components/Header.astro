---
import { Image } from "astro:assets";
import ThemeToggle from "./ThemeToggle.astro";
import logo from "../assets/logo.png";
import { site } from "../config/site";

const links = [
  { href: "/#servicios", label: "Servicios" },
  { href: "/#consultorio", label: "Consultorio" },
  { href: "/#sobre-mi", label: "Sobre mí" },
  { href: "/#ubicacion", label: "Ubicación" },
];
---

<header
  class="fixed top-0 z-50 w-full border-b border-gray-200 bg-white/90 backdrop-blur-md dark:border-gray-800 dark:bg-gray-950/90"
>
  <nav class="wrap py-3" aria-label="Principal">
    <div class="flex items-center justify-between">
      <!-- Logo/Brand -->
      <a href="/#inicio" class="flex items-center gap-2.5">
        <Image
          src={logo}
          alt=""
          width={40}
          height={40}
          class="h-10 w-10 rounded-full"
          loading="eager"
        />
        <span
          class="font-display text-2xl font-medium tracking-tight text-gray-900 dark:text-white"
          >{site.name}</span
        >
      </a>

      <!-- Navigation Links -->
      <div class="hidden items-center gap-7 md:flex">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-[15px] font-medium text-gray-700 transition-colors hover:text-teal-700 dark:text-gray-300 dark:hover:text-teal-300"
            >
              {link.label}
            </a>
          ))
        }
        <a href="/#citas" class="btn btn-primary btn-sm">Agendar cita</a>
        <ThemeToggle />
      </div>

      <!-- Mobile Menu Button & Theme Toggle -->
      <div class="flex items-center gap-3 md:hidden">
        <ThemeToggle />
        <button
          id="mobile-menu-button"
          type="button"
          class="rounded-lg p-2 text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="mt-3 hidden border-t border-gray-200 pt-3 md:hidden dark:border-gray-800"
    >
      <div class="flex flex-col gap-1">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="rounded-lg px-2 py-2.5 font-medium text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800"
            >
              {link.label}
            </a>
          ))
        }
        <a href="/#citas" class="btn btn-primary mt-2">Agendar cita</a>
      </div>
    </div>
  </nav>
</header>

<script>
  const mobileMenuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");

  function setMenuOpen(open: boolean) {
    mobileMenu?.classList.toggle("hidden", !open);
    mobileMenuButton?.setAttribute("aria-expanded", String(open));
  }

  mobileMenuButton?.addEventListener("click", () => {
    setMenuOpen(mobileMenu?.classList.contains("hidden") ?? false);
  });

  // Close mobile menu when clicking on a link
  const mobileLinks = mobileMenu?.querySelectorAll("a");
  mobileLinks?.forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });
</script>
