---
const services = [
  {
    title: "Odontología Preventiva",
    description:
      "Limpiezas dentales, aplicación de flúor y selladores para mantener tu sonrisa saludable.",
  },
  {
    title: "Estética Dental",
    description:
      "Blanqueamiento, carillas y diseño de sonrisa para que luzcas radiante.",
  },
  {
    title: "Ortodoncia",
    description:
      "Brackets tradicionales e invisibles para corregir la posición de tus dientes.",
  },
  {
    title: "Implantes Dentales",
    description:
      "Reemplazo de piezas dentales perdidas con tecnología de última generación.",
  },
  {
    title: "Endodoncia",
    description:
      "Tratamientos de conducto realizados con precisión y sin dolor.",
  },
  {
    title: "Odontopediatría",
    description:
      "Cuidado dental especializado para los más pequeños de la familia.",
  },
];
---

<section id="servicios" class="py-16 md:py-24">
  <div class="wrap">
    <h2 class="section-title">Servicios</h2>
    <p class="section-lead">
      Tratamientos para toda la familia, desde la limpieza de rutina hasta la
      rehabilitación completa.
    </p>

    <!-- Services Grid -->
    <ul
      class="mt-10 grid gap-x-10 border-t border-gray-200 sm:grid-cols-2 lg:grid-cols-3 dark:border-gray-800"
    >
      {
        services.map((service) => (
          <li class="border-b border-gray-200 py-7 dark:border-gray-800">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
              {service.title}
            </h3>
            <p class="mt-2 leading-relaxed text-gray-600 dark:text-gray-400">
              {service.description}
            </p>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 text-gray-700 dark:text-gray-300">
      ¿No encuentras el tratamiento que buscas?
      <a
        href="#citas"
        class="font-semibold text-teal-700 underline underline-offset-4 hover:text-teal-800 dark:text-teal-300 dark:hover:text-teal-200"
        >Agenda una valoración</a
      >
      y revisamos tu caso.
    </p>
  </div>
</section>
