---
import { Image } from "astro:assets";
import consultorio from "../assets/consultorio.png";
import { site } from "../config/site";
---

<section
  id="inicio"
  class="bg-teal-50/60 pt-28 pb-16 md:pt-36 md:pb-24 dark:bg-gray-900"
>
  <div class="wrap grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
    <!-- Text Content -->
    <div>
      <h1
        class="font-display text-4xl font-medium leading-[1.08] tracking-tight text-gray-900 sm:text-5xl lg:text-6xl dark:text-white"
      >
        Tu dentista de confianza en {site.address.locality}
      </h1>

      <p
        class="mt-6 max-w-xl text-lg leading-relaxed text-gray-700 dark:text-gray-300"
      >
        En el consultorio de la {site.name} recibes atención personal, sin
        prisas y con explicaciones claras antes de cada tratamiento.
      </p>

      <!-- CTA Buttons -->
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="#citas" class="btn btn-primary">Agendar cita</a>
        <a href="#servicios" class="btn btn-secondary">Ver servicios</a>
      </div>

      <!-- Stats -->
      {
        site.stats.length > 0 && (
          <dl class="mt-10 flex gap-10 border-t border-teal-900/10 pt-6 dark:border-gray-800">
            {site.stats.map((stat) => (
              <div class="flex flex-col-reverse">
                <dt class="mt-0.5 text-sm text-gray-600 dark:text-gray-400">
                  {stat.label}
                </dt>
                <dd class="font-display text-3xl font-medium text-gray-900 dark:text-white">
                  {stat.value}
                </dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>

    <!-- Photo of the practice -->
    <div class="mx-auto w-full max-w-md lg:max-w-none">
      <Image
        src={consultorio}
        alt={`La ${site.name} atendiendo a una paciente en su consultorio`}
        widths={[400, 640, 900]}
        sizes="(min-width: 1024px) 40vw, 90vw"
        class="aspect-[4/5] w-full rounded-2xl object-cover"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
